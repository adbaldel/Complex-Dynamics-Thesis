    url          = {https://raco.cat/index.php/ButlletiSCM/article/view/221259},
    abstractNote = {Usant com a fil conductor el mètode de Newton per a polinomis complexos, aquesta lliçó pretén mostrar els diferents comportaments que poden tenir les òrbites d?un sistema dinàmic generat per la iteració d?una funció analítica del pla complex. Veurem com aquestes òrbites s?agrupen en conjunts invariants amb dinàmiques molt variades, separats per fronteres fractals amb propietats remarcables, tant topològiques com dinàmiques.},
    number       = {1},
    journal      = {Butlletí de la Societat Catalana de Matemàtiques},
    author       = {Fagella Rabionet, Núria},
