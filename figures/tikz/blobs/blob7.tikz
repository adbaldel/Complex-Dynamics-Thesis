\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (4) at (-0.5, 4.25) {};
		\node [style=none] (7) at (3.75, 1.75) {};
		\node [style=none] (8) at (3.5, -2.25) {};
		\node [style=none] (9) at (-0.75, -4.25) {};
		\node [style=none] (10) at (-4, 2.25) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [bend left] (10.center) to (4.center);
		\draw [bend left] (7.center) to (8.center);
		\draw [bend left] (8.center) to (9.center);
		\draw [bend left=45] (9.center) to (10.center);
		\draw [bend left, looseness=0.75] (4.center) to (7.center);
	\end{pgfonlayer}
\end{tikzpicture}
