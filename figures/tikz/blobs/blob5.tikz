\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (4) at (-3.75, 4) {};
		\node [style=none] (5) at (0.75, 4) {};
		\node [style=none] (6) at (1.75, 0.75) {};
		\node [style=none] (7) at (4.5, -0.75) {};
		\node [style=none] (8) at (5, -4.25) {};
		\node [style=none] (9) at (0.75, -4.25) {};
		\node [style=none] (10) at (-3.75, 0) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [bend left=15] (10.center) to (4.center);
		\draw [bend left=75] (4.center) to (5.center);
		\draw [bend right=15, looseness=1.25] (5.center) to (6.center);
		\draw [bend right, looseness=0.75] (6.center) to (7.center);
		\draw [bend left=75] (7.center) to (8.center);
		\draw [bend left=15] (8.center) to (9.center);
		\draw [bend left] (9.center) to (10.center);
	\end{pgfonlayer}
\end{tikzpicture}
