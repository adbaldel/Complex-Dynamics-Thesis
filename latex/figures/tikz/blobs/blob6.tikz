\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (4) at (-1.5, 4) {};
		\node [style=none] (7) at (3.25, 3.25) {};
		\node [style=none] (8) at (3, -2.75) {};
		\node [style=none] (9) at (-0.75, -4.5) {};
		\node [style=none] (10) at (-3.75, 0) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [bend left=15] (10.center) to (4.center);
		\draw [bend left] (7.center) to (8.center);
		\draw [bend left] (8.center) to (9.center);
		\draw [bend left=45] (9.center) to (10.center);
		\draw [bend left=45] (4.center) to (7.center);
	\end{pgfonlayer}
\end{tikzpicture}
