\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-4.5, 3.25) {};
		\node [style=none] (1) at (1.25, 3) {};
		\node [style=none] (2) at (4.75, -0.25) {};
		\node [style=none] (3) at (1.75, -4) {};
		\node [style=none] (4) at (0, -2.25) {};
		\node [style=none] (5) at (-5.75, -0.75) {};
		\node [style=none] (6) at (-2.25, -1.5) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [bend left=45, looseness=0.75] (5.center) to (0.center);
		\draw [bend left, looseness=0.50] (0.center) to (1.center);
		\draw [bend left=15, looseness=0.75] (1.center) to (2.center);
		\draw [bend left=75] (2.center) to (3.center);
		\draw [bend left=15] (3.center) to (4.center);
		\draw [bend right=45, looseness=0.75] (5.center) to (6.center);
		\draw [bend left=45, looseness=0.75] (6.center) to (4.center);
	\end{pgfonlayer}
\end{tikzpicture}
