# --- Fonts & LaTeX ---
text.usetex: True               # use LaTeX for text rendering (matches thesis fonts)
font.family: serif
font.serif: [Computer Modern Roman]
text.latex.preamble: \usepackage{amsmath, amssymb}

# --- Font sizes (tuned for ~\textwidth figures in a thesis) ---
font.size: 11
axes.titlesize: 12
axes.labelsize: 11
xtick.labelsize: 9
ytick.labelsize: 9
legend.fontsize: 9
figure.titlesize: 13

# --- Figure size & resolution ---
figure.figsize: 8.0, 5.0        # good default for a single-column thesis figure
figure.dpi: 100                 # screen preview
savefig.dpi: 300                # print-quality export
savefig.bbox: tight
savefig.pad_inches: 0.02

# --- Lines & markers ---
lines.linewidth: 1.2
lines.markersize: 6
axes.linewidth: 0.8

# --- Axes & grid ---
axes.grid: True
grid.alpha: 0.3
grid.linewidth: 0.5
axes.spines.top: False
axes.spines.right: False
axes.axisbelow: True            # grid behind data

# --- Ticks ---
xtick.direction: in
ytick.direction: in
xtick.major.size: 3.5
ytick.major.size: 3.5
xtick.minor.visible: False
ytick.minor.visible: False

# --- Legend ---
legend.frameon: False
legend.loc: best